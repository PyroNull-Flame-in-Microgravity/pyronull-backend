# Informational only; the application does not currently branch on APP_ENV.
APP_ENV=development
# Informational only; routes are currently mounted at /api/v1.
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GEMINI_API_KEY=
# Only the verified free-tier eligible model is accepted; other values fail closed.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=25000
GEMINI_REQUESTS_PER_MINUTE=30
PORT=8001
